{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/producto?slug=:slug"
    }
  ],
  "functions": {
    "api/producto.js": {
      "includeFiles": "index.html"
    },
    "api/admin.js": {
      "includeFiles": "neon/schema.sql",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/panel",
      "destination": "/admin.html",
      "permanent": false
    }
  ]
}
